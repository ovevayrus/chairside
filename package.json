{
  "name": "chairside",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "npm run build -w @chairside/shared && npm run build -w @chairside/server && npm run build -w @chairside/glasses && npm run check:secrets",
    "e2e": "node e2e/run.mjs",
    "pack": "node scripts/pack.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "demo:local": "node scripts/demo-local.mjs",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:block": "tsx scripts/demo-block.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "smoke:live": "node scripts/not-implemented.mjs smoke:live",
    "spike:telegram": "tsx scripts/spike-telegram.ts",
    "spike:calendar": "tsx scripts/spike-calendar.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "globals": "^17.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.0.0",
    "tree-kill": "^1.2.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.1"
  }
}
