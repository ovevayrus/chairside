{
  "name": "chairside",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "npm run build -w @chairside/shared && npm run build -w @chairside/server && npm run build -w @chairside/glasses && npm run check:secrets",
    "e2e": "node scripts/not-implemented.mjs e2e",
    "pack": "node scripts/not-implemented.mjs pack",
    "check:secrets": "node scripts/check-secrets.mjs",
    "demo:local": "node scripts/not-implemented.mjs demo:local",
    "demo:seed": "node scripts/not-implemented.mjs demo:seed",
    "demo:block": "node scripts/not-implemented.mjs demo:block",
    "demo:reset": "node scripts/not-implemented.mjs demo:reset",
    "smoke:live": "node scripts/not-implemented.mjs smoke:live"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.1"
  }
}
