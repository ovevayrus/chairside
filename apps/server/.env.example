# Copy to apps/server/.env and fill in. The real .env is git-ignored; never commit it.
# Paths are relative to apps/server.

# Telegram: @BotFather -> /newbot, then Bot Settings -> Secretary Mode (formerly Business Mode) -> on.
TELEGRAM_BOT_TOKEN=
# business = replies come from the owner's own account (Telegram Business); bot = customers DM the bot.
TELEGRAM_MODE=business
# Numeric Telegram user id of the shop owner (message @userinfobot from the owner account).
OWNER_TELEGRAM_USER_ID=
# Inline "Book" buttons on offers. Proven to work on Business messages (docs/SPIKES.md S1).
CALLBACKS_SUPPORTED=true

# Google Calendar: a service-account JSON key, and a calendar shared with the service account's
# email address with "Make changes to events".
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=secrets/service-account.json
GOOGLE_CALENDAR_ID=

# Shop and server.
SHOP_CONFIG_PATH=../../config/shop.demo.json
PORT=8787
# Default: data/chairside.db (TEST MODE uses data/test.db). Set it only to move the file;
# TEST MODE and the live server refuse to share one database.
# DATABASE_PATH=data/chairside.db
# A long random string; generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DEVICE_TOKEN_PEPPER=
# 1 = TEST MODE (fake Telegram and calendar, dev-only endpoints). Development only.
DEV_INJECT=0

# npm run smoke:live only: Telegram user ids of the test customer accounts, comma-separated
# (message @userinfobot from each). The live runner acts only on cards from these chats.
# SMOKE_CUSTOMER_IDS=
